        "3d9ea84d-5527-4bce-abe6-5debef3ec955": {
          "type": "custom",
          "settings": {
            "open_tab_mobile": false,
            "title": "Delivery Information",
            "type": "all",
            "content": "<section class=\"faq-section\">\n  <h3>Delivery Information </h3>\n  \n  <div class=\"faq-item\">\n    <h3>How long will it take for my order to be made and dispatched?</h3>\n    <p>Our standard dispatch time is 5 – 7 working days (see individual product pages for current lead times as this may vary).</p>\n    <p>Express orders will be made and dispatched within 2-3 working days.</p>\n    <p>Super express orders will be made and dispatched the following working day (if ordered before 12pm).</p>\n    <p>During busier periods (e.g., Mother’s Day/Christmas), our dispatch times can be up to 7-14 working days. These will be updated on our website at the time.</p>\n    <p>Collection from our studio may be available by prior arrangement.</p>\n  </div>\n\n  <div class=\"faq-item\">\n    <h3>How long does shipping take?</h3>\n    <p>We use Royal Mail or Yodel for all deliveries. Tracked 24 aims to deliver items within 1 working day of dispatch, and Tracked 48 aims to deliver items within 2-3 working days of dispatch.</p>\n    <p>Dispatch notifications will be sent via text or email. All delivery times are estimates. Please be advised that delays in the delivery service do occasionally take place; however, we do everything we can to assist in these cases.</p>\n    <p>DAISY MAISON CANNOT BE HELD RESPONSIBLE FOR DELAYS IN ADVERTISED DELIVERY TIMESCALES.</p>\n  </div>\n\n  <div class=\"faq-item\">\n    <h3>How will my order be packaged?</h3>\n    <p>All orders are boxed or suitably packed in padded envelopes. Fragile items are protected from damage using environmentally friendly internal packaging. Where possible, we use recycled packaging materials.</p>\n  </div>\n\n  <div class=\"faq-item\">\n    <h3>Returns & Exchanges</h3>\n    <p>As all of our products are handmade to order, items are non-refundable. In the unlikely event an item contains an error or sustains damage during delivery, we will replace it and cover postage costs for returning the faulty product. Return of items should be made via The Post Office, and packaging must be suitable to ensure damage does not occur during return transit. Where possible, original packaging should be used. Cost of return will be refunded by us immediately. We must be made aware of faulty/damaged items within 48hrs of receipt.</p>\n  </div>\n\n  <div class=\"faq-item\">\n    <h3>Additional information</h3>\n    <p>We cannot take responsibility for incorrect delivery addresses entered at the checkout. Any loss caused by incorrect addresses, financial or otherwise, will be your responsibility, unless the negligence is ours. Orders are delivered by courier and are subject to the terms and conditions of these third parties.</p>\n  </div>\n\n</section>\n\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long will it take for my order to be made and dispatched?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"Our standard dispatch time is 5 – 7 working days (see individual product pages for current lead times as this may vary). Express orders will be made and dispatched within 2-3 working days. Super express orders will be made and dispatched the following working day (if ordered before 12pm). During busier periods (e.g., Mother’s Day/Christmas), our dispatch times can be up to 7-14 working days. These will be updated on our website at the time. Collection from our studio may be available by prior arrangement.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does shipping take?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We use Amazon 24/48 or Yodel 48 for all deliveries. Amazon 24 aims to deliver items within 1 working day of dispatch, and Tracked48 aims to deliver items within 2-3 working days of dispatch. Dispatch notifications will be sent via text or email. All delivery times are estimates. Please be advised that delays in the delivery service do occasionally take place; however, we do everything we can to assist in these cases. DAISY MAISON CANNOT BE HELD RESPONSIBLE FOR DELAYS IN ADVERTISED ROYAL MAIL DELIVERY TIMESCALES.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How will my order be packaged?\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"All orders are boxed or suitably packed in padded envelopes. Fragile items are protected from damage using environmentally friendly internal packaging. Where possible, we use recycled packaging materials.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Returns & Exchanges\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"As all of our products are handmade to order, items are non-refundable. In the unlikely event an item contains an error or sustains damage during delivery, we will replace it and cover postage costs for returning the faulty product. Return of items should be made via The Post Office, and packaging must be suitable to ensure damage does not occur during return transit. Where possible, original packaging should be used. Cost of return will be refunded by us immediately. We must be made aware of faulty/damaged items within 48hrs of receipt.\"\n      }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Additional information\",\n      \"acceptedAnswer\": {\n        \"@type\": \"Answer\",\n        \"text\": \"We cannot take responsibility for incorrect delivery addresses entered at the checkout. Any loss caused by incorrect addresses, financial or otherwise, will be your responsibility, unless the negligence is ours. Orders are delivered by courier and are subject to the terms and conditions of these third parties.\"\n      }\n    }\n  ]\n}\n</script>",
