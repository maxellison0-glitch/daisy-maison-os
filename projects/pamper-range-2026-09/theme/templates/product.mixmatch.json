        "custom_liquid_pUXpbm": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"dm-trust-badges\"><span>⭐ 5/5 Feefo Rated</span><span>🏆 Gold Trusted Service 2026</span><span>✅ 3,326+ Verified Reviews</span></div>\n\n{% if template.name == 'product' and product.handle == 'mr-mrs-personalised-street-sign-gift' %} <div style=\"display: none;\" id=\"dm-sticky-cart\"\n class=\"dm-sticky-cart\">\n  <span class=\"dm-sticky-title\">Mr &amp; Mrs Street Sign</span>\n  <button class=\"dm-sticky-btn\" onclick=\"document.getElementById('product-add-to-cart').click();\">Add to Cart</button>\n</div>\n<script>\n(function(){\n  var sticky = document.getElementById('dm-sticky-cart');\n  var origBtn = document.getElementById('product-add-to-cart');\n  if(!sticky || !origBtn) return;\n  function checkScroll(){\n    var rect = origBtn.getBoundingClientRect();\n    if(rect.bottom < 0){\n      sticky.classList.add('dm-sticky-visible');\n    } else {\n      sticky.classList.remove('dm-sticky-visible');\n    }\n  }\n  window.addEventListener('scroll', checkScroll, {passive: true});\n})();\n</script>\n{% endif %}"
