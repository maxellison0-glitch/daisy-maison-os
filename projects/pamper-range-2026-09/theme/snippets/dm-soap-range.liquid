{%- comment -%}
  dm-soap-range: the mix & match offer on soap product pages (templates/product.soap.json).
    mode 'deal'  : one line under the price.
    mode 'collection': heading, offer and basket progress at the top of
                   /collections/handmade-soap (templates/collection.soap.json).
    mode 'range' : "Mix & match any 3 for £12" with every soap in the Handmade Soap
                   collection as a one-tap Add card, a progress line read from the
                   basket, and the gift wrap picker (assets/daisy-wrap-kits.js mounts
                   it into [data-dm-wrap-instant]).
  The £12 price itself is the automatic discount "Soap: any 3 for £12" (3+ items from
  the Handmade Soap collection, 19.2% off = £4.00 each). Change the price there and
  in dm_sr_deal below together. New scents join automatically: set Product type = Soap.
  Bath bombs (Product type = Bath Bomb, collection bath-bombs) use the same page with
  a "Choose your cocktail" strip and no deal until one is agreed.
{%- endcomment -%}
{%- liquid
  assign dm_sr_kind = 'soap'
  if mode == 'collection'
    if collection.handle == 'bath-bombs'
      assign dm_sr_kind = 'bath'
    endif
  elsif product.type == 'Bath Bomb'
    assign dm_sr_kind = 'bath'
  endif
  if dm_sr_kind == 'bath'
    assign dm_sr_col = collections['bath-bombs']
    assign dm_sr_deal = ''
    assign dm_sr_title = 'Choose your cocktail'
    assign dm_sr_all = 'See all bath bombs'
    assign dm_sr_h1 = 'Cocktail Bath Bombs'
    assign dm_sr_lede = 'Sets of three 150g bath bombs, each one individually wrapped and packed in a kraft gift box. Made in the UK.'
    assign dm_sr_min = 2
  else
    assign dm_sr_col = collections['handmade-soap']
    assign dm_sr_deal = 'Mix & match any 3 soaps for £12'
    assign dm_sr_title = 'Mix & match any 3 for £12'
    assign dm_sr_all = 'See all soaps'
    assign dm_sr_h1 = 'Handmade Soap'
    assign dm_sr_lede = 'Hand-cut 100g slices, each sealed in a resealable kraft pouch. Made in the UK.'
    assign dm_sr_min = 1
  endif
  if mode == 'collection'
    assign dm_sr_min = 1
  endif
-%}
{%- if mode == 'deal' -%}
{%- if dm_sr_deal != blank -%}
<p class="dm-soap-deal"><span class="dm-soap-deal__pill">Offer</span> {{ dm_sr_deal }}</p>
<style>
.dm-soap-deal{display:flex;align-items:center;gap:8px;margin:-6px 0 14px;font-size:14px;font-weight:600;color:#2b2b2b}
.dm-soap-deal__pill{flex:0 0 auto;padding:2px 9px;border-radius:999px;background:var(--dm-sage,#b0af9b);color:#fff;font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}
</style>
{%- endif -%}
{%- elsif dm_sr_col and dm_sr_col.products_count >= dm_sr_min -%}
{%- if mode == 'collection' -%}
<div class="dm-soap-top">
  <h1 class="dm-soap-top__title">{{ dm_sr_h1 }}</h1>
  <p class="dm-soap-top__lede">{{ dm_sr_lede }}</p>
{%- endif -%}
<div class="dm-soap-range" data-dm-soap-range>
  <div class="dm-soap-range__head">
    <p class="dm-soap-range__title">{{ dm_sr_title | escape }}</p>
    {%- if mode == 'range' -%}<a class="dm-soap-range__all" href="{{ dm_sr_col.url }}">{{ dm_sr_all }}</a>{%- endif -%}
  </div>
  {%- if dm_sr_kind == 'soap' -%}
  <div class="dm-soap-range__bar" aria-hidden="true"><span></span><span></span><span></span></div>
  <p class="dm-soap-range__status" data-dm-soap-status aria-live="polite">Add any 3 soaps and pay £12.</p>
  {%- endif -%}
  {%- if mode == 'collection' and dm_sr_kind == 'soap' -%}
  <ul class="dm-soap-steps">
    <li>Pick any 3 soaps: mix the scents or double up on a favourite.</li>
    <li>The £12 price drops in automatically in your basket.</li>
    <li>Every soap after that is £4.</li>
  </ul>
  {%- elsif mode == 'range' -%}
  <div class="dm-soap-range__cards">
    {%- for p in dm_sr_col.products limit: 8 -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      {%- assign nm = p.title | remove: ' Bath Bomb Set' | remove: ' Soap' -%}
      {%- assign im_alt = p.featured_image.alt | default: p.title -%}
      <div class="dm-soap-card{% if p.id == product.id %} is-current{% endif %}">
        {%- if p.id == product.id -%}
          <span class="dm-soap-card__img">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, height: 120, alt: im_alt }}{%- endif -%}</span>
          <span class="dm-soap-card__name">{{ nm }}</span>
          <span class="dm-soap-card__tag">You're viewing</span>
        {%- else -%}
          <a class="dm-soap-card__img" href="{{ p.url }}">{%- if p.featured_image -%}{{ p.featured_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, height: 120, alt: im_alt }}{%- endif -%}</a>
          <a class="dm-soap-card__name" href="{{ p.url }}">{{ nm }}</a>
          <span class="dm-soap-card__tag">{{ v.price | money }}</span>
        {%- endif -%}
        <button type="button" class="dm-soap-card__add" data-dm-soap-add="{{ v.id }}" data-name="{{ nm | escape }}"{% unless v.available %} disabled{% endunless %}>{% if v.available %}Add{% else %}Sold out{% endif %}</button>
      </div>
    {%- endfor -%}
  </div>
  {%- endif -%}
</div>
{%- if mode == 'collection' -%}</div>{%- else -%}<div data-dm-wrap-instant></div>{%- endif -%}
<style>
.dm-soap-top{max-width:720px;margin:0 auto;padding:6px 16px 14px;text-align:center}
.dm-soap-top__title{margin:0 0 6px;font-size:26px;line-height:1.2;color:#232323}
.dm-soap-top__lede{margin:0 0 14px;font-size:14px;color:#5a5a5a}
.dm-soap-top .dm-soap-range{text-align:left;margin:0}
.dm-soap-steps{margin:0;padding-left:18px;display:grid;gap:4px;font-size:13px;color:#3c3c3c}
.dm-soap-range{margin:6px 0 12px;padding:14px;border:1px solid #ece6dd;border-radius:12px;background:#fcfbf9}
.dm-soap-range__head{display:flex;align-items:baseline;justify-content:space-between;gap:10px}
.dm-soap-range__title{margin:0;font-size:15px;font-weight:700;color:#232323}
.dm-soap-range__all{font-size:12.5px;font-weight:600;color:#5f6449;text-decoration:underline;white-space:nowrap}
.dm-soap-range__bar{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;margin:10px 0 6px}
.dm-soap-range__bar span{height:6px;border-radius:999px;background:#e8e3da;transition:background .2s ease}
.dm-soap-range__bar span.is-on{background:var(--dm-sage,#b0af9b)}
.dm-soap-range__status{margin:0 0 10px;font-size:13px;line-height:1.4;color:#5a5a5a}
.dm-soap-range__status strong{color:#2f3724}
.dm-soap-range__cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
.dm-soap-card{display:flex;flex-direction:column;align-items:center;gap:4px;min-width:0;padding:8px 6px;border:1px solid #e4ddd4;border-radius:12px;background:#fff;text-align:center}
.dm-soap-card.is-current{border-color:var(--dm-sage,#b0af9b);background:#f3f5ec}
.dm-soap-card__img{display:block;width:100%;max-width:96px}
.dm-soap-card__img img{display:block;width:100%;height:auto;aspect-ratio:1;object-fit:cover;border-radius:8px}
.dm-soap-card__name{font-size:12.5px;font-weight:700;line-height:1.2;color:#232323;text-decoration:none;min-height:2.4em;display:flex;align-items:center}
.dm-soap-card__tag{font-size:11.5px;color:#8a8a7a}
.dm-soap-card__add{width:100%;margin-top:2px;padding:7px 4px;border:1px solid #d7d3c5;border-radius:999px;background:#fff;color:#232323;font:inherit;font-size:12.5px;font-weight:700;cursor:pointer}
.dm-soap-card__add:disabled{opacity:.55;cursor:default}
.dm-soap-card__add.is-added{background:#87a878;border-color:#87a878;color:#fff}
.dm-wrap-instant .dm-sa-btn{width:100%;border:1px solid #d7d3c5;border-radius:999px;background:#fff;color:#232323;font-size:13px;font-weight:700;padding:9px 14px;cursor:pointer}
.dm-wrap-instant .dm-sa-btn:disabled{cursor:default}
.dm-wrap-instant .dm-sa-btn.dm-sa-added{background:#87a878;border-color:#87a878;color:#fff}
</style>
<script>
(function () {
  var root = document.querySelector('[data-dm-soap-range]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var status = root.querySelector('[data-dm-soap-status]');
  if (!status) status = { set innerHTML(v) {} };
  var bars = root.querySelectorAll('.dm-soap-range__bar span');
  function paint(n) {
    for (var i = 0; i < bars.length; i++) bars[i].classList.toggle('is-on', i < Math.min(n, 3));
    var text;
    if (n <= 0) text = 'Add any 3 soaps and pay £12.';
    else if (n === 1) text = '1 soap in your basket. Add 2 more and pay <strong>£12 for 3</strong>.';
    else if (n === 2) text = '2 soaps in your basket. Add 1 more and pay <strong>£12 for all 3</strong>.';
    else text = '<strong>✓ 3 for £12 unlocked.</strong> The price drops in your basket, and every extra soap is £4.';
    status.innerHTML = text;
  }
  function count() {
    return fetch('/cart.js', { credentials: 'same-origin', headers: { Accept: 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var n = 0;
        (cart.items || []).forEach(function (i) { if (String(i.product_type || '').toLowerCase() === 'soap') n += i.quantity; });
        paint(n);
        return n;
      }).catch(function () { return 0; });
  }
  root.addEventListener('click', function (e) {
    var btn = e.target.closest('[data-dm-soap-add]');
    if (!btn || btn.disabled) return;
    e.preventDefault();
    btn.disabled = true;
    var label = btn.textContent;
    btn.textContent = 'Adding…';
    fetch('/cart/add.js', { method: 'POST', credentials: 'same-origin', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify({ items: [{ id: Number(btn.getAttribute('data-dm-soap-add')), quantity: 1 }] }) })
      .then(function (r) { if (!r.ok) throw new Error('add'); return count(); })
      .then(function () {
        btn.classList.add('is-added');
        btn.textContent = '✓ Added';
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        setTimeout(function () { btn.classList.remove('is-added'); btn.textContent = 'Add another'; btn.disabled = false; }, 1600);
      })
      .catch(function () { btn.textContent = label; btn.disabled = false; });
  });
  // Recount when the main Add to cart (or anything else) changes the basket.
  document.addEventListener('cart:refresh', function () { setTimeout(count, 400); });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) count(); });
  var form = document.querySelector('form[action*="/cart/add"]');
  if (form) form.addEventListener('submit', function () { setTimeout(count, 1500); });
  var atc = document.querySelector('#product-add-to-cart');
  if (atc) atc.addEventListener('click', function () { setTimeout(count, 1500); });
  count();
})();
</script>
{%- elsif mode == 'range' -%}
<div data-dm-wrap-instant></div>
<style>
.dm-wrap-instant .dm-sa-btn{width:100%;border:1px solid #d7d3c5;border-radius:999px;background:#fff;color:#232323;font-size:13px;font-weight:700;padding:9px 14px;cursor:pointer}
.dm-wrap-instant .dm-sa-btn:disabled{cursor:default}
.dm-wrap-instant .dm-sa-btn.dm-sa-added{background:#87a878;border-color:#87a878;color:#fff}
</style>
{%- endif -%}
