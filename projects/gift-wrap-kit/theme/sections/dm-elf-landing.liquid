    <a href="/products/santa-stop-here-personalised-christmas-street-sign"><img src="https://cdn.shopify.com/s/files/1/0897/0017/2115/files/Santa-Stop-Here-Red.jpg?v=1725219464&amp;width=400" width="400" height="400" alt="Santa Stop Here personalised Christmas street sign" loading="lazy"><span class="lp-c-body"><strong>Santa Stop Here street sign</strong>£18.95</span></a>
  </div>
</div>

<p class="lp-trustbar">Buy with confidence from an established family business, <a href="https://uk.trustpilot.com/review/daisymaison.co.uk" rel="noopener" target="_blank">rated Excellent on Trustpilot</a> and loved by more than 8,300 customers across the UK.</p>

<script>
(function(){
  var form=document.getElementById('dm-elf-form');if(!form)return;
  var BASE=1195, POSTCARD={{ product.selected_or_first_available_variant.id }};
  var V_SECOND=54848138936659, V_SHEETS=54847925584211, V_BUNDLE=54847925846355;
  var PLUSH={one:{v:54846943887699,p:795},two:{v:54848333971795,p:1395}};
  var PJ={one:{v:54847808667987,p:795},two:{v:54848335380819,p:1395}};
  var WRAP={ v: {{ dm_wrap_v.id | default: 0 }}, p: {{ dm_wrap_v.price | default: 0 }} };
  var totalEl=document.getElementById('dm-total'), note=document.getElementById('dm-bundle-note');
  var sib=document.getElementById('dm-sib'), sibFields=document.getElementById('dm-sib-fields'), offerBox=document.getElementById('dm-offer-box');
  var plush=document.getElementById('dm-add-plush'), pj=document.getElementById('dm-add-pj'), sheets=document.getElementById('dm-add-sheets');
  var wrap=document.getElementById('dm-add-wrap'), wrapRow=document.querySelector('[data-row="wrap"]'), wrapLabel=document.querySelector('[data-price-label="wrap"]');
  var mainImg=document.getElementById('dm-main-img');
  document.querySelectorAll('.lp-thumbs button').forEach(function(b){b.addEventListener('click',function(){mainImg.removeAttribute('srcset');mainImg.src=b.getAttribute('data-full');document.querySelectorAll('.lp-thumbs button').forEach(function(x){x.removeAttribute('aria-current')});b.setAttribute('aria-current','true');});});
  function qtyOf(name){if(!sib.checked)return 1;var r=document.querySelector('input[name="'+name+'"][value="2"]');return r&&r.checked?2:1}
  function bundleActive(){return pj.checked&&qtyOf('pjqty')===1&&sheets.checked}
  function recalc(){
    var t=BASE;
    if(sib.checked)t+=995;
    if(plush.checked)t+=(qtyOf('plushqty')===2?PLUSH.two.p:PLUSH.one.p);
    if(wrap&&wrap.checked)t+=(qtyOf('wrapqty')===2?WRAP.p+Math.round(WRAP.p/2):WRAP.p);
    if(bundleActive()){t+=995;note.style.display='block'}else{note.style.display='none';if(pj.checked)t+=(qtyOf('pjqty')===2?PJ.two.p:PJ.one.p);if(sheets.checked)t+=495}
    offerBox.classList.toggle('lp-sel',sib.checked);
    document.querySelector('[data-row="plush"]').classList.toggle('lp-sel',plush.checked);
    document.querySelector('[data-row="pj"]').classList.toggle('lp-sel',pj.checked);
    document.querySelector('[data-row="sheets"]').classList.toggle('lp-sel',sheets.checked);
    if(wrapRow)wrapRow.classList.toggle('lp-sel',!!(wrap&&wrap.checked));
    if(wrapLabel)wrapLabel.textContent='+£'+(((wrap&&wrap.checked&&qtyOf('wrapqty')===2)?WRAP.p+Math.round(WRAP.p/2):WRAP.p)/100).toFixed(2);
    document.querySelectorAll('.lp-qty').forEach(function(q){q.classList.toggle('lp-show',sib.checked)});
    document.querySelector('[data-price-label="plush"]').textContent=(plush.checked&&qtyOf('plushqty')===2)?'+£13.95':'+£7.95';
    document.querySelector('[data-price-label="pj"]').textContent=(pj.checked&&qtyOf('pjqty')===2)?'+£13.95':'+£7.95';
    document.querySelectorAll('.lp-chip').forEach(function(c){c.classList.toggle('lp-on',c.querySelector('input').checked)});
    totalEl.textContent='£'+(t/100).toFixed(2);
  }
  [sib,plush,pj,sheets,wrap].filter(Boolean).forEach(function(c){c.addEventListener('change',recalc)});
  document.querySelectorAll('.lp-qty input').forEach(function(r){r.addEventListener('change',function(){
    var row=r.closest('.lp-check').querySelector('input[type="checkbox"]');
    if(!row.checked){row.checked=true}
    recalc();
  })});
  sib.addEventListener('change',function(){
    sibFields.hidden=!sib.checked;
    if(!sib.checked){document.querySelectorAll('.lp-qty input[value="1"]').forEach(function(r){r.checked=true})}
    recalc();
  });
  recalc();
  form.addEventListener('submit',function(e){
    e.preventDefault();
    var err=document.getElementById('dm-form-err');err.style.display='none';
    var bad=null;
    var checks=[['dm-child',true],['dm-elf',true],['dm-addr',true],['dm-child2',sib.checked],['dm-elf2',sib.checked],['dm-addr2',sib.checked]];
    checks.forEach(function(p){
      var el=document.getElementById(p[0]),wrap=el.closest('.lp-field');
      var isBad=p[1]&&!el.value.trim();
      wrap.classList.toggle('lp-err',isBad);
      if(isBad&&!bad)bad=el;
    });
    if(bad){bad.focus();return}
    var items=[{id:POSTCARD,quantity:1,properties:{"Child's name(s)":document.getElementById('dm-child').value.trim(),"Elf's name":document.getElementById('dm-elf').value.trim(),"Address":document.getElementById('dm-addr').value.trim()}}];
    if(sib.checked)items.push({id:V_SECOND,quantity:1,properties:{"Child's name(s)":document.getElementById('dm-child2').value.trim(),"Elf's name":document.getElementById('dm-elf2').value.trim(),"Address":document.getElementById('dm-addr2').value.trim()}});
    if(plush.checked)items.push({id:(qtyOf('plushqty')===2?PLUSH.two.v:PLUSH.one.v),quantity:1});
    if(wrap&&wrap.checked&&WRAP.v)items.push({id:WRAP.v,quantity:(qtyOf('wrapqty')===2?2:1),properties:{'Add-on':'Christmas Gift Wrap Kit'}});
    if(bundleActive()){items.push({id:V_BUNDLE,quantity:1})}else{if(pj.checked)items.push({id:(qtyOf('pjqty')===2?PJ.two.v:PJ.one.v),quantity:1});if(sheets.checked)items.push({id:V_SHEETS,quantity:1})}
    var btn=document.getElementById('dm-cta');btn.disabled=true;btn.textContent='Adding…';
    fetch('/cart/add.js',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({items:items})}).then(function(r){if(!r.ok)throw r;window.location.href='/cart'}).catch(function(){btn.disabled=false;btn.textContent='Add to basket';err.textContent='Something went wrong adding to the basket. Please try again.';err.style.display='block'});
  });
})();
</script>
</div>

