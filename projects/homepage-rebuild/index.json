    "dm_home_styles": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "{%- comment -%}\n  Daisy Maison homepage layout fixes (homepage rebuild, Sep 2026).\n  Lives in templates/index.json as the \"dm_home_styles\" custom-liquid section,\n  first in the order so it applies before the hero paints. Homepage only:\n  every rule is scoped to .template-index or to a homepage section id.\n  Source of truth: daisy-maison-os/projects/homepage-rebuild/dm-home-styles.liquid\n{%- endcomment -%}\n<style>\n/* 1. Sentence case for the hero and section headings (the theme capitalises every word) */\n.template-index [id^=\"halo-image-banner-\"] .banner-heading,\n.template-index .halo-block-header .title,\n.template-index .halo-block-header .title .text{text-transform:none!important}\n\n/* 2. Hero on phones: headline card sits under the photo instead of covering it */\n@media (max-width:767px){\n  .template-index [id^=\"halo-image-banner-\"] .img-box--mobile .image-mobile{padding-top:80%!important}\n  .template-index [id^=\"halo-image-banner-\"] .item--largeImg .content-box--absolute{\n    position:relative!important;top:auto!important;left:auto!important;right:auto!important;bottom:auto!important;\n    transform:none!important;width:100%!important;max-width:none!important;max-height:none!important;\n    overflow:visible!important;border-radius:0!important;margin:0!important;padding:18px 20px 22px!important}\n}\n\n/* 3. Hero: the second button reads as a small text link under the main button */\n.template-index [id^=\"halo-image-banner-\"] .banner-action .banner-button.banner-button-2,\n.template-index [id^=\"halo-image-banner-\"] .banner-action .banner-button.banner-button-2:hover{\n  background:none!important;border-color:transparent!important;box-shadow:none!important;color:#5a4a3a!important;\n  width:auto!important;max-width:none!important;min-width:0!important;height:auto!important;min-height:0!important;\n  display:block!important;padding:0!important;margin:12px auto 0!important;font-size:14px!important;line-height:1.4!important;\n  text-transform:none!important;letter-spacing:0!important;border-radius:0!important;transform:none!important}\n.template-index [id^=\"halo-image-banner-\"] .banner-button-2 span{text-decoration:underline;text-underline-offset:3px}\n\n/* 4. Product cards on the homepage: no sale badges, no struck-through prices */\n.template-index .sections-product-block .badge.sale-badge,\n.template-index .sections-product-block .card-price .price__compare,\n.template-index .sections-product-block .card-price .price__saved{display:none!important}\n.template-index .sections-product-block .price--on-sale .price-item--sale,\n.template-index .sections-product-block .price--on-sale .price-item--sale .money{color:var(--product-price-color)!important}\n\n/* 5. Tile rows: three across on phones (Ella only offers one or two) */\n@media (max-width:767px){\n  .spotlight-block[id$=\"__spotlight_block_JFKrLj\"] .halo-row.scroll-snap-mobile .halo-item,\n  .spotlight-block[id$=\"__dm_occasion_row_2\"] .halo-row.scroll-snap-mobile .halo-item{flex:0 0 30%!important;max-width:none!important;scroll-snap-stop:normal!important}\n  .spotlight-block[id$=\"__dm_recipient_row_1\"] .halo-row.column-mb-2 .halo-item,\n  .spotlight-block[id$=\"__dm_recipient_row_2\"] .halo-row.column-mb-2 .halo-item{width:33.3333%!important}\n  .template-index .spotlight-block .spotlight-inner .title.custom-text-style{margin-top:8px!important;margin-bottom:0!important;line-height:1.25!important}\n}\n\n/* 6. Proof strip: 2 x 2 on phones, no slider */\n@media (max-width:767px){\n  .custom-service-block[class*=\"__16393870238958f868\"] .halo-row{display:flex!important;flex-wrap:wrap!important;row-gap:10px}\n  .custom-service-block[class*=\"__16393870238958f868\"] .halo-row .halo-item{width:50%!important}\n  .custom-service-block[class*=\"__16393870238958f868\"] .halo-row .halo-item+.halo-item{margin-top:0!important}\n  .custom-service-block[class*=\"__16393870238958f868\"] .halo-item>a{height:100%}\n}\n\n/* 7. How it works: picture left, words right on phones */\n@media (max-width:767px){\n  .custom-service-block[class*=\"__dm_how_it_works\"] .halo-item>a{display:flex!important;flex-direction:row!important;align-items:center!important;gap:14px;text-align:left!important}\n  .custom-service-block[class*=\"__dm_how_it_works\"] .policies-icon{flex:0 0 40%;max-width:40%;margin:0!important}\n  .custom-service-block[class*=\"__dm_how_it_works\"] .policies-content{flex:1 1 auto;text-align:left!important}\n}\n.custom-service-block[class*=\"__dm_how_it_works\"] .policies-icon img{width:100%!important;height:auto!important;border-radius:10px;display:block}\n\n/* 8. Reviews: product photo as a small square, product name links to the product */\n.customer-review-block[class*=\"__dm_reviews\"] .review__item-image{max-width:140px!important;margin:0 auto 12px!important}\n.customer-review-block[class*=\"__dm_reviews\"] .review__item-image img{border-radius:10px}\n.customer-review-block[class*=\"__dm_reviews\"] .heading a{color:inherit;text-decoration:underline;text-underline-offset:3px}\n</style>"
