{% liquid
  assign picture_product = section.settings.picture_product
  assign sign_product = section.settings.sign_product
  assign heart_product = section.settings.heart_product

  assign picture_image = section.settings.picture_image
  if picture_image == blank and picture_product != blank
    assign picture_image = picture_product.featured_image
  endif
  assign sign_image = section.settings.sign_image
  if sign_image == blank and sign_product != blank
    assign sign_image = sign_product.featured_image
  endif
  assign heart_image = section.settings.heart_image
  if heart_image == blank and heart_product != blank
    assign heart_image = heart_product.featured_image
  endif

  assign picture_url = section.settings.picture_collection.url
  if picture_url == blank and picture_product != blank
    assign picture_url = picture_product.url
  endif
  assign sign_url = section.settings.sign_collection.url
  if sign_url == blank and sign_product != blank
    assign sign_url = sign_product.url
  endif
  assign heart_url = section.settings.heart_collection.url
  if heart_url == blank and heart_product != blank
    assign heart_url = heart_product.url
  endif
%}

<daisy-shop-window id="DaisyShopWindow-{{ section.id }}" class="daisy-window" data-section-id="{{ section.id }}">
  <section class="daisy-window__story" aria-labelledby="DaisyShopWindowTitle-{{ section.id }}">
    <div class="daisy-window__sticky">
      <div class="daisy-window__frame">
        <span class="daisy-window__rule daisy-window__rule--vertical" aria-hidden="true"></span>
        <span class="daisy-window__rule daisy-window__rule--horizontal" aria-hidden="true"></span>

        <div class="daisy-window__copy">
          <p class="daisy-window__eyebrow">{{ section.settings.eyebrow }}</p>
          <h1 id="DaisyShopWindowTitle-{{ section.id }}" class="daisy-window__title">{{ section.settings.heading }}</h1>
          <p class="daisy-window__body">{{ section.settings.body }}</p>
          <a class="daisy-window__shop" href="{{ section.settings.shop_url }}">
            <span>{{ section.settings.shop_label }}</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="daisy-window__display" aria-label="{{ section.settings.display_label | escape }}">
          <a class="daisy-window__object daisy-window__object--picture" href="{{ picture_url }}">
            <span class="daisy-window__media daisy-window__media--picture">
              {% if picture_image != blank %}
                {{ picture_image | image_url: width: 1100 | image_tag: class: 'daisy-window__image', widths: '320, 480, 640, 800, 1100', sizes: '(min-width: 990px) 34vw, 31vw', loading: 'eager', fetchpriority: 'high' }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'daisy-window__placeholder' }}
              {% endif %}
            </span>
            <span class="daisy-window__label">
              <span class="daisy-window__number">01</span>
              <span>
                <strong>{{ section.settings.picture_label }}</strong>
                <small>{{ section.settings.picture_relationship }}</small>
              </span>
              {% if picture_product != blank %}
                <span class="daisy-window__price">{{ picture_product.price | money }}</span>
              {% endif %}
            </span>
          </a>

          <a class="daisy-window__object daisy-window__object--sign" href="{{ sign_url }}">
            <span class="daisy-window__media daisy-window__media--sign">
              {% if sign_image != blank %}
                {{ sign_image | image_url: width: 1200 | image_tag: class: 'daisy-window__image', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 990px) 42vw, 31vw', loading: 'eager' }}
              {% else %}
                {{ 'product-2' | placeholder_svg_tag: 'daisy-window__placeholder' }}
              {% endif %}
            </span>
            <span class="daisy-window__label">
              <span class="daisy-window__number">02</span>
              <span>
                <strong>{{ section.settings.sign_label }}</strong>
                <small>{{ section.settings.sign_relationship }}</small>
              </span>
              {% if sign_product != blank %}
                <span class="daisy-window__price">{{ sign_product.price | money }}</span>
              {% endif %}
            </span>
          </a>

          <a class="daisy-window__object daisy-window__object--heart" href="{{ heart_url }}">
            <span class="daisy-window__media daisy-window__media--heart">
              {% if heart_image != blank %}
                {{ heart_image | image_url: width: 800 | image_tag: class: 'daisy-window__image', widths: '240, 360, 480, 640, 800', sizes: '(min-width: 990px) 21vw, 31vw', loading: 'eager' }}
              {% else %}
                {{ 'product-3' | placeholder_svg_tag: 'daisy-window__placeholder' }}
              {% endif %}
            </span>
            <span class="daisy-window__label">
              <span class="daisy-window__number">03</span>
              <span>
                <strong>{{ section.settings.heart_label }}</strong>
                <small>{{ section.settings.heart_relationship }}</small>
              </span>
              {% if heart_product != blank %}
                <span class="daisy-window__price">{{ heart_product.price | money }}</span>
              {% endif %}
            </span>
          </a>
        </div>

        <div class="daisy-window__reveal" aria-hidden="true">
          <span>{{ section.settings.reveal_first }}</span>
          <span>{{ section.settings.reveal_second }}</span>
          <span>{{ section.settings.reveal_third }}</span>
        </div>

        <p class="daisy-window__closing">{{ section.settings.closing }}</p>
        <p class="daisy-window__hint">{{ section.settings.scroll_hint }}</p>
      </div>
    </div>
  </section>
</daisy-shop-window>

{% stylesheet %}
  .daisy-window {
    --daisy-progress: 0;
    --daisy-ink: #262923;
    --daisy-sage: #afb09c;
    --daisy-paper: #f4efe7;
    --daisy-blush: #ddc5bc;
    --daisy-line: rgba(38, 41, 35, 0.23);
    display: block;
    color: var(--daisy-ink);
    background: var(--daisy-paper);
  }

  .wrapper-body:has(.section-daisy-shop-window) {
    overflow: visible !important;
  }

  .daisy-window *,
  .daisy-window *::before,
  .daisy-window *::after {
    box-sizing: border-box;
  }

  .daisy-window__story {
    position: relative;
    height: 150svh;
    min-height: 980px;
    background:
      linear-gradient(90deg, transparent 49.94%, rgba(38, 41, 35, 0.035) 50%, transparent 50.06%),
      var(--daisy-paper);
  }

  .daisy-window__sticky {
    position: sticky;
    top: 0;
    height: clamp(560px, calc(100svh - 172px), 760px);
    min-height: 560px;
    overflow: hidden;
  }

  .daisy-window__frame {
    position: relative;
    width: min(100%, 1600px);
    height: 100%;
    margin: 0 auto;
    overflow: hidden;
    isolation: isolate;
    border-top: 1px solid var(--daisy-line);
    border-bottom: 1px solid var(--daisy-line);
    background:
      radial-gradient(circle at 76% 12%, rgba(255, 255, 255, 0.78), transparent 30%),
      linear-gradient(118deg, #f6f1e9 0 35%, #e4e0d3 35% 69%, #d4c0b7 69% 100%);
  }

  .daisy-window__frame::before {
    content: '';
    position: absolute;
    inset: 15px;
    z-index: 0;
    border: 1px solid rgba(38, 41, 35, 0.2);
    pointer-events: none;
  }

  .daisy-window__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 6;
    opacity: 0.19;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.84' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.16'/%3E%3C/svg%3E");
    mix-blend-mode: multiply;
  }

  .daisy-window__rule {
    position: absolute;
    z-index: 1;
    display: block;
    background: var(--daisy-line);
    pointer-events: none;
  }

  .daisy-window__rule--vertical {
    top: 15px;
    bottom: 15px;
    left: 34%;
    width: 1px;
  }

  .daisy-window__rule--horizontal {
    right: 15px;
    bottom: 77px;
    left: 15px;
    height: 1px;
  }

  .daisy-window__copy {
    position: absolute;
    top: 50%;
    left: clamp(40px, 5.6vw, 92px);
    z-index: 5;
    width: min(29vw, 410px);
    transform: translateY(calc(-50% - var(--daisy-progress) * 28px));
    opacity: calc(1 - var(--daisy-progress) * 1.35);
    transition: opacity 80ms linear;
  }

  .daisy-window__eyebrow {
    margin: 0 0 18px;
    font: 600 11px/1.2 Arial, sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .daisy-window__title {
    max-width: 7.5em;
    margin: 0;
    font: 400 clamp(48px, 5vw, 78px)/0.92 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.055em;
  }

  .daisy-window__body {
    max-width: 32em;
    margin: 26px 0 0;
    font: 400 clamp(14px, 1.05vw, 17px)/1.65 Arial, sans-serif;
  }

  .daisy-window__shop {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 42px;
    min-width: 190px;
    margin-top: 28px;
    padding: 13px 0 11px;
    border-bottom: 1px solid currentColor;
    color: inherit;
    font: 600 12px/1 Arial, sans-serif;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .daisy-window__shop:focus-visible,
  .daisy-window__object:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 4px;
    box-shadow: 0 0 0 5px var(--daisy-ink);
  }

  .daisy-window__display {
    position: absolute;
    inset: 30px 32px 90px 35%;
    z-index: 3;
  }

  .daisy-window__object {
    position: absolute;
    display: block;
    color: inherit;
    text-decoration: none;
    transform-origin: center;
  }

  .daisy-window__media {
    position: relative;
    display: block;
    overflow: hidden;
    background: #e9e4dc;
    box-shadow: 0 18px 48px rgba(50, 43, 35, 0.16);
    transition: box-shadow 220ms ease;
  }

  .daisy-window__media::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(38, 41, 35, 0.18);
    pointer-events: none;
  }

  .daisy-window__image,
  .daisy-window__placeholder {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    transition: transform 450ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .daisy-window__object:hover .daisy-window__media {
    box-shadow: 0 22px 58px rgba(50, 43, 35, 0.22);
  }

  .daisy-window__object:hover .daisy-window__image {
    transform: scale(1.025);
  }

  .daisy-window__object--picture {
    top: 3%;
    left: 4%;
    z-index: 2;
    width: clamp(260px, 29vw, 430px);
    transform: translate3d(calc(var(--daisy-progress) * -6vw), calc(var(--daisy-progress) * 2vh), 0) rotate(calc(-1.7deg + var(--daisy-progress) * 1.7deg));
  }

  .daisy-window__media--picture {
    aspect-ratio: 1 / 1.08;
  }

  .daisy-window__object--sign {
    right: 0;
    bottom: 1%;
    z-index: 4;
    width: clamp(390px, 43vw, 650px);
    transform: translate3d(calc(var(--daisy-progress) * -11vw), calc(var(--daisy-progress) * -17vh), 0) rotate(calc(-3.2deg + var(--daisy-progress) * 3.2deg)) scale(calc(1 - var(--daisy-progress) * 0.12));
  }

  .daisy-window__media--sign {
    aspect-ratio: 2.45 / 1;
  }

  .daisy-window__object--heart {
    top: 0;
    right: 2%;
    z-index: 5;
    width: clamp(190px, 20vw, 310px);
    transform: translate3d(calc(var(--daisy-progress) * 3vw), calc(var(--daisy-progress) * 19vh), 0) rotate(calc(2.2deg - var(--daisy-progress) * 2.2deg));
  }

  .daisy-window__media--heart {
    aspect-ratio: 0.94 / 1;
  }

  .daisy-window__object--heart .daisy-window__label {
    padding-right: 8px;
    padding-left: 8px;
    background: rgba(244, 239, 231, 0.94);
  }

  .daisy-window__label {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 10px;
    align-items: start;
    margin-top: 8px;
    padding: 8px 2px 0;
    border-top: 1px solid var(--daisy-line);
    font-family: Arial, sans-serif;
  }

  .daisy-window__number {
    padding-top: 2px;
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .daisy-window__label strong,
  .daisy-window__label small {
    display: block;
  }

  .daisy-window__label strong {
    font-size: 12px;
    line-height: 1.15;
    letter-spacing: 0.02em;
  }

  .daisy-window__label small {
    margin-top: 2px;
    font-size: 10px;
    line-height: 1.2;
    opacity: 0.68;
  }

  .daisy-window__price {
    padding-top: 1px;
    font-size: 10px;
    white-space: nowrap;
  }

  .daisy-window__reveal {
    position: absolute;
    inset: auto 5vw 106px 5vw;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    opacity: clamp(0, calc((var(--daisy-progress) - 0.38) * 2.2), 1);
    color: rgba(38, 41, 35, 0.62);
    font: italic 400 clamp(18px, 2.2vw, 32px)/1 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.03em;
    pointer-events: none;
  }

  .daisy-window__closing {
    position: absolute;
    bottom: 24px;
    left: 50%;
    z-index: 5;
    margin: 0;
    transform: translateX(-50%) translateY(calc((1 - var(--daisy-progress)) * 12px));
    opacity: clamp(0, calc((var(--daisy-progress) - 0.52) * 2.2), 1);
    font: 400 clamp(22px, 2.2vw, 34px)/1 Georgia, 'Times New Roman', serif;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }

  .daisy-window__hint {
    position: absolute;
    bottom: 26px;
    left: clamp(40px, 5.6vw, 92px);
    z-index: 5;
    margin: 0;
    opacity: calc(0.6 - var(--daisy-progress));
    font: 600 9px/1 Arial, sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (max-width: 1100px) and (min-width: 750px) {
    .daisy-window__copy {
      left: 40px;
      width: 29vw;
    }

    .daisy-window__title {
      font-size: clamp(42px, 5vw, 58px);
    }

    .daisy-window__display {
      right: 24px;
      left: 34%;
    }

    .daisy-window__object--picture {
      width: 31vw;
    }

    .daisy-window__object--sign {
      width: 47vw;
    }

    .daisy-window__object--heart {
      width: 22vw;
    }
  }

  @media (max-width: 749px) {
    .daisy-window__story {
      height: auto;
      min-height: 0;
    }

    .daisy-window__sticky {
      position: relative;
      height: auto;
      min-height: 0;
      overflow: visible;
    }

    .daisy-window__frame {
      min-height: 0;
      padding: 42px 16px 28px;
      overflow: hidden;
      border-bottom: 1px solid var(--daisy-line);
      background: var(--daisy-paper);
    }

    .daisy-window__frame::before {
      inset: 8px;
    }

    .daisy-window__rule,
    .daisy-window__reveal,
    .daisy-window__hint {
      display: none;
    }

    .daisy-window__copy {
      position: relative;
      top: auto;
      left: auto;
      width: auto;
      transform: none;
      opacity: 1;
    }

    .daisy-window__eyebrow {
      margin-bottom: 12px;
      font-size: 9px;
    }

    .daisy-window__title {
      max-width: 8em;
      font-size: clamp(42px, 14vw, 58px);
    }

    .daisy-window__body {
      margin-top: 18px;
      font-size: 13px;
      line-height: 1.5;
    }

    .daisy-window__shop {
      min-width: 165px;
      margin-top: 18px;
      font-size: 10px;
    }

    .daisy-window__display {
      position: relative;
      inset: auto;
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 7px;
      margin-top: 30px;
    }

    .daisy-window__object,
    .daisy-window__object--picture,
    .daisy-window__object--sign,
    .daisy-window__object--heart {
      position: relative;
      inset: auto;
      width: auto;
      transform: none;
    }

    .daisy-window__media,
    .daisy-window__media--picture,
    .daisy-window__media--sign,
    .daisy-window__media--heart {
      aspect-ratio: 0.82 / 1;
      box-shadow: none;
    }

    .daisy-window__object--sign .daisy-window__image {
      object-fit: cover;
    }

    .daisy-window__label {
      grid-template-columns: 1fr;
      gap: 2px;
      margin-top: 6px;
      padding-top: 6px;
    }

    .daisy-window__number,
    .daisy-window__price,
    .daisy-window__label small {
      display: none;
    }

    .daisy-window__label strong {
      font-size: 10px;
      line-height: 1.2;
    }

    .daisy-window__closing {
      position: relative;
      bottom: auto;
      left: auto;
      margin: 28px 0 0;
      transform: none;
      opacity: 1;
      font-size: 21px;
      white-space: normal;
    }
  }

  .daisy-window[data-static] .daisy-window__story {
    height: auto;
    min-height: 0;
  }

  .daisy-window[data-static] .daisy-window__sticky {
    position: relative;
  }

  @media (prefers-reduced-motion: reduce), (pointer: coarse) {
    .daisy-window,
    .daisy-window * {
      scroll-behavior: auto;
    }

    .daisy-window__story {
      height: auto;
      min-height: 0;
    }

    .daisy-window__sticky {
      position: relative;
    }

    .daisy-window__object,
    .daisy-window__copy,
    .daisy-window__closing,
    .daisy-window__reveal {
      transition: none;
    }

    .daisy-window__image {
      transform: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('daisy-shop-window')) {
    customElements.define('daisy-shop-window', class extends HTMLElement {
      connectedCallback() {
        this.story = this.querySelector('.daisy-window__story');
        this.reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        this.coarse = window.matchMedia('(pointer: coarse)').matches;
        this.saveData = Boolean(navigator.connection && navigator.connection.saveData);
        this.enabled = Boolean(this.story && !this.reduced && !this.coarse && !this.saveData && window.IntersectionObserver && window.innerWidth >= 750);
        this.frame = null;
        this.onScroll = this.onScroll.bind(this);
        this.onResize = this.onResize.bind(this);
        this.toggleAttribute('data-static', !this.enabled);
        if (!this.enabled) return;
        this.observer = new IntersectionObserver((entries) => {
          this.visible = entries[0].isIntersecting;
          if (this.visible) {
            window.addEventListener('scroll', this.onScroll, { passive: true });
            this.onScroll();
          } else {
            window.removeEventListener('scroll', this.onScroll);
          }
        }, { rootMargin: '25% 0px' });
        this.observer.observe(this.story);
        window.addEventListener('resize', this.onResize, { passive: true });
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        window.removeEventListener('scroll', this.onScroll);
        window.removeEventListener('resize', this.onResize);
        if (this.frame) cancelAnimationFrame(this.frame);
      }

      onResize() {
        if (window.innerWidth < 750) {
          this.style.removeProperty('--daisy-progress');
          return;
        }
        this.onScroll();
      }

      onScroll() {
        if (!this.visible || this.frame) return;
        this.frame = requestAnimationFrame(() => {
          const rect = this.story.getBoundingClientRect();
          const distance = Math.max(1, this.story.offsetHeight - window.innerHeight);
          const progress = Math.min(1, Math.max(0, -rect.top / distance));
          this.style.setProperty('--daisy-progress', progress.toFixed(4));
          this.frame = null;
        });
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "Daisy shop window",
  "tag": "section",
  "class": "section-daisy-shop-window",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Handmade in Lancashire" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made from your story." },
    { "type": "textarea", "id": "body", "label": "Introduction", "default": "A name. A date. A place. Small details that turn a gift into something they keep." },
    { "type": "text", "id": "shop_label", "label": "Shop link label", "default": "Shop all gifts" },
    { "type": "url", "id": "shop_url", "label": "Shop link" },
    { "type": "text", "id": "display_label", "label": "Product display accessible label", "default": "Shop our personalised gift collections" },
    { "type": "header", "content": "Pebble pictures" },
    { "type": "product", "id": "picture_product", "label": "Bestselling product" },
    { "type": "collection", "id": "picture_collection", "label": "Destination collection" },
    { "type": "image_picker", "id": "picture_image", "label": "Optional image override" },
    { "type": "text", "id": "picture_label", "label": "Family label", "default": "Pebble pictures" },
    { "type": "text", "id": "picture_relationship", "label": "Relationship label", "default": "For the people" },
    { "type": "header", "content": "Street signs" },
    { "type": "product", "id": "sign_product", "label": "Bestselling product" },
    { "type": "collection", "id": "sign_collection", "label": "Destination collection" },
    { "type": "image_picker", "id": "sign_image", "label": "Optional image override" },
    { "type": "text", "id": "sign_label", "label": "Family label", "default": "Street signs" },
    { "type": "text", "id": "sign_relationship", "label": "Relationship label", "default": "For the place" },
    { "type": "header", "content": "Hanging hearts" },
    { "type": "product", "id": "heart_product", "label": "Bestselling product" },
    { "type": "collection", "id": "heart_collection", "label": "Destination collection" },
    { "type": "image_picker", "id": "heart_image", "label": "Optional image override" },
    { "type": "text", "id": "heart_label", "label": "Family label", "default": "Hanging hearts" },
    { "type": "text", "id": "heart_relationship", "label": "Relationship label", "default": "For the moment" },
    { "type": "header", "content": "Scroll reveal" },
    { "type": "text", "id": "reveal_first", "label": "First detail", "default": "a name" },
