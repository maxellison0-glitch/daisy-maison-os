diff -ruN orig/snippets/dm-upsell-accordion.liquid new/snippets/dm-upsell-accordion.liquid
--- orig/snippets/dm-upsell-accordion.liquid	1970-01-01 00:00:00.000000000 +0000
+++ new/snippets/dm-upsell-accordion.liquid	2026-09-29 15:08:02.050882550 +0000
@@ -0,0 +1,171 @@
+{%- comment -%}
+  dm-upsell-accordion — folds the optional extras on product pages into tidy
+  one-line rows (name, price, thumbnail; tap to open), so the Add to Cart
+  isn't buried under a stack of add-on cards. Team request, 29 Sep.
+
+  Covers every builder's add-on cards (.dm-cyg__card: gift box, gift wrap kit,
+  mounting strips, easel, matching heart, …) and the diffuser's "Fancy another
+  look?" extra tag. "Buying another gift?" on the diffusers is already a
+  <details>, so it is only restyled to match.
+
+  Non-destructive: nothing is moved or re-rendered. The block's own header
+  becomes the toggle and everything that isn't the header, a path to it or
+  the thumbnail is marked .dm-acc__body; CSS hides those while closed. Builder
+  scripts keep finding their inputs and hidden fields still submit.
+
+  - A row starts closed unless something in it is already chosen.
+  - Tapping anywhere on a closed row opens it (the thumbnail still zooms).
+  - A chosen row shows "✓ Added" in its header.
+  - Pressing Add to Cart opens every chosen row first, so any wording a
+    builder asks for is on screen if its validation needs it.
+{%- endcomment -%}
+<style>
+  .dm-acc{ scroll-margin-top: 90px; }
+  .dm-acc--closed .dm-acc__body{ display: none !important; }
+  .dm-acc--closed{ cursor: pointer; }
+  .dm-acc__head{ cursor: pointer; position: relative; padding-right: 30px !important; -webkit-tap-highlight-color: transparent; }
+  .dm-acc__head::after{
+    content: ""; position: absolute; right: 8px; top: 50%; width: 8px; height: 8px;
+    border-right: 2px solid #2b2b2b; border-bottom: 2px solid #2b2b2b;
+    transform: translateY(-75%) rotate(45deg); transition: transform .2s ease;
+  }
+  .dm-acc:not(.dm-acc--closed) .dm-acc__head::after{ transform: translateY(-25%) rotate(-135deg); }
+  .dm-acc__head:focus-visible{ outline: 2px solid #9b9a83; outline-offset: 3px; border-radius: 6px; }
+  .dm-acc__added{ display: none; margin-left: 6px; color: #2e7d4f; font-size: 12px; font-weight: 800; letter-spacing: 0; text-transform: none; white-space: nowrap; }
+  .dm-acc--chosen .dm-acc__added{ display: inline; }
+  .dm-acc__hint{ margin-left: 6px; color: #6f6e5c; font-size: 13px; font-weight: 700; letter-spacing: 0; text-transform: none; white-space: nowrap; }
+  .dm-acc--chosen .dm-acc__hint{ display: none; }
+
+  /* Closed rows sit tight so the list reads as a menu */
+  .dm-acc--closed.dm-cyg__card{ padding-top: 10px !important; padding-bottom: 10px !important; min-height: 0 !important; }
+  .dm-acc--closed .dm-cyg__media{ align-items: center !important; }
+  .dm-acc--closed .dm-cyg__thumb{ width: 48px !important; height: 48px !important; }
+  .dm-acc--closed .dm-cyg__thumb--heart{ width: 48px !important; height: 48px !important; }
+  .dm-acc--closed .dm-cyg__media::after{ display: none !important; }
+  .dm-acc .dm-cyg__top{ align-items: center; }
+
+  /* "Fancy another look?" as a matching row */
+  .dm-acc.dm-diffuser-extra-tag{ border: 1px solid #ece6dd !important; border-radius: 12px !important; background: #fcfbf9 !important; padding: 12px 14px !important; }
+  .dm-acc.dm-diffuser-extra-tag > .dm-acc__head{ margin: 0 !important; font-size: 16px !important; }
+  .dm-acc.dm-diffuser-extra-tag:not(.dm-acc--closed) > .dm-acc__head{ margin-bottom: 8px !important; }
+
+  /* "Buying another gift?" (already a <details>) styled as the same row */
+  details.dm-diffuser-secondary-offer{ border: 1px solid #ece6dd !important; border-radius: 12px !important; background: #fcfbf9 !important; padding: 12px 14px !important; }
+  details.dm-diffuser-secondary-offer > summary{ list-style: none; cursor: pointer; position: relative; padding-right: 30px; font-weight: 700; }
+  details.dm-diffuser-secondary-offer > summary::-webkit-details-marker{ display: none; }
+  details.dm-diffuser-secondary-offer > summary::after{
+    content: ""; position: absolute; right: 8px; top: 50%; width: 8px; height: 8px;
+    border-right: 2px solid #2b2b2b; border-bottom: 2px solid #2b2b2b;
+    transform: translateY(-75%) rotate(45deg); transition: transform .2s ease;
+  }
+  details.dm-diffuser-secondary-offer[open] > summary::after{ transform: translateY(-25%) rotate(-135deg); }
+</style>
+<script>
+(function () {
+  // [block selector, header selector inside it]
+  var TARGETS = [
+    ['.dm-cyg__card', '.dm-cyg__top'],
+    ['section.dm-diffuser-extra-tag', '.dm-diffuser-extra-tag__title']
+  ];
+  var NONE_RX = /^(no\b|none|no thanks)/i;
+  var ATC = 'button[name="add"], [data-heart-submit], .product-form__submit, #product-add-to-cart';
+
+  function visible(el) { return !!(el.offsetParent || el.getClientRects().length) && !el.closest('[hidden]'); }
+
+  function chosen(block) {
+    if (block.hasAttribute('data-addon-mode')) return block.getAttribute('data-addon-mode') !== 'none';
+    if (block.hasAttribute('data-heart-boxmode-current')) return block.getAttribute('data-heart-boxmode-current') !== 'none';
+    var ticked = [].some.call(block.querySelectorAll('input[type="checkbox"]:checked'), function (i) {
+      var lab = i.closest('label'); return !NONE_RX.test(((lab && lab.innerText) || '').trim());
+    });
+    if (ticked) return true;
+    return [].some.call(block.querySelectorAll('.dm-addon-mode__option.is-active, .dm-addon-mode__option[aria-pressed="true"]'), function (o) {
+      return !o.closest('.dm-acc__body [hidden], [hidden]') && !NONE_RX.test((o.innerText || '').trim());
+    });
+  }
+
+  // Everything off the path from block to header (and not a thumbnail) is body.
+  function mark(block, head) {
+    var node = head;
+    while (node && node !== block) {
+      var parent = node.parentElement;
+      [].forEach.call(parent.children, function (sib) {
+        if (sib === node || sib.classList.contains('dm-acc__body')) return;
+        if (sib.matches('img.dm-cyg__thumb, .dm-cyg__thumb, style, script')) return;
+        sib.classList.add('dm-acc__body');
+      });
+      node = parent;
+    }
+  }
+
+  function setOpen(block, open) {
+    block.classList.toggle('dm-acc--closed', !open);
+    var head = block.querySelector('.dm-acc__head');
+    if (head) head.setAttribute('aria-expanded', open ? 'true' : 'false');
+  }
+
+  function refresh() {
+    document.querySelectorAll('.dm-acc').forEach(function (b) {
+      mark(b, b.querySelector('.dm-acc__head'));
+      b.classList.toggle('dm-acc--chosen', chosen(b));
+    });
+  }
+
+  function enhance() {
+    TARGETS.forEach(function (t) {
+      document.querySelectorAll(t[0]).forEach(function (block) {
+        if (block.classList.contains('dm-acc') || !block.closest('form, .productView-details, .productView-product')) return;
+        var head = block.querySelector(t[1]);
+        if (!head || !visible(block)) return;
+        block.classList.add('dm-acc');
+        head.classList.add('dm-acc__head');
+        head.setAttribute('role', 'button');
+        head.setAttribute('tabindex', '0');
+        if (!/£\d/.test(head.innerText)) {
+          var m = (block.innerText || '').match(/£\d+(?:\.\d\d)?/);
+          if (m) head.insertAdjacentHTML('beforeend', '<span class="dm-acc__hint">+' + m[0] + '</span>');
+        }
+        head.insertAdjacentHTML('beforeend', '<span class="dm-acc__added">✓ Added</span>');
+        mark(block, head);
+        var on = chosen(block);
+        block.classList.toggle('dm-acc--chosen', on);
+        setOpen(block, on);
+        // Some cards fill in later (the gift wrap colour tiles); fold those in too.
+        if (window.MutationObserver) {
+          var pending = false;
+          new MutationObserver(function () {
+            if (pending) return; pending = true;
+            requestAnimationFrame(function () { pending = false; mark(block, head); });
+          }).observe(block, { childList: true, subtree: true });
+        }
+      });
+    });
+  }
+
+  document.addEventListener('click', function (e) {
+    var t = e.target;
+    var head = t.closest('.dm-acc__head');
+    var closedBlock = t.closest('.dm-acc--closed');
+    if (head || (closedBlock && !t.closest('[data-dm-zoomable], a'))) {
+      var block = head ? head.closest('.dm-acc') : closedBlock;
+      e.preventDefault(); e.stopPropagation();
+      setOpen(block, block.classList.contains('dm-acc--closed'));
+      return;
+    }
+    if (t.closest(ATC)) {
+      refresh();
+      document.querySelectorAll('.dm-acc--chosen.dm-acc--closed').forEach(function (b) { setOpen(b, true); });
+    }
+    setTimeout(refresh, 80);
+  }, true);
+  document.addEventListener('change', function () { setTimeout(refresh, 80); }, true);
+  document.addEventListener('keydown', function (e) {
+    var h = e.target;
+    if ((e.key === 'Enter' || e.key === ' ') && h.classList && h.classList.contains('dm-acc__head')) { e.preventDefault(); h.click(); }
+  });
+
+  // Builders render after load; keep enhancing for the first 15 seconds.
+  var tries = 0;
+  (function tick() { enhance(); if (++tries < 30) setTimeout(tick, 500); })();
+})();
+</script>
