 @media(max-width:749px){.pet-sign{padding:0 0 38px;font-size:17px}.pet-sign__layout{display:flex;flex-direction:column;gap:0}.pet-sign__media{position:static;order:0;width:100%}.pet-sign__hero{border-radius:0;max-height:430px;width:100%;background:#efeee7}.pet-sign__hero img{object-fit:contain}.pet-sign__facts{font-size:14px;gap:5px 12px;padding:0 13px;margin:12px 0 0}.pet-sign__heading{order:1;margin:23px 0 22px;padding:0 20px;width:100%}.pet-sign__eyebrow{font-size:14px;letter-spacing:.055em}.pet-sign h1{font-size:35px;margin-bottom:10px}.pet-sign__intro{font-size:18px;margin-bottom:13px}.pet-sign__personalise{order:2;padding:0 20px;width:100%}.pet-sign__price>[data-pet-price]{font-size:26px}.pet-sign__preview-box{padding:18px 11px 13px;margin-bottom:23px}.pet-sign__preview{min-height:70px}.pet-sign__preview-caption{font-size:14px}.pet-sign__colour-options{gap:6px}.pet-sign__colour>span{padding:7px 8px}.pet-sign__size-options{gap:7px}.pet-sign__size>span{min-height:112px}.pet-sign__size small{font-size:14px}.pet-sign__below{display:block;margin:32px 20px 0;padding-top:30px}.pet-sign__story{margin-bottom:32px}.pet-sign h2{font-size:26px}.pet-sign__faqs summary{font-size:17px}.pet-sign__delivery{font-size:15px}}
 @media(prefers-reduced-motion:reduce){.pet-sign *{transition:none!important}}
+
+/* ── 2 Oct: advert-matched landing additions ──────────────────────────── */
+.pet-sign__rating{display:flex;align-items:center;flex-wrap:wrap;gap:8px;margin:0 0 12px;font-size:16px;font-weight:600;color:var(--pet-ink)}
+.pet-sign__stars{color:#d9a441;letter-spacing:2px;font-size:17px}
+.pet-sign__compare{font-size:18px;color:#8a8a7a;font-weight:500}
+.pet-sign__save{display:inline-block;padding:3px 9px;border-radius:999px;background:#2e7d4f;color:#fff;font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
+.pet-sign__name{display:grid;gap:9px;margin:0 0 6px}
+.pet-sign__name input{border-width:2px!important}
+.pet-sign__mode{margin:6px 0 22px}
+.pet-sign__mode .pet-sign__text-button{font-size:16px;font-weight:600;padding:8px 0;min-height:44px;cursor:pointer}
+.pet-sign__preview-box.is-sample{border-style:dashed}
+.pet-sign__preview-box.is-sample .pet-sign__preview-caption{color:var(--pet-ink);font-weight:600}
+.pet-sign__proof-line{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;gap:8px;margin:12px 0 0;font-size:15px;font-weight:600}
+
+/* How it works */
+.pet-sign__steps{margin:0 0 34px}
+.pet-sign__steps ol{list-style:none;margin:0;padding:0;display:grid;gap:12px}
+.pet-sign__steps li{display:flex;align-items:flex-start;gap:14px;margin:0;font-size:17px;line-height:1.5}
+.pet-sign__steps li b{flex:0 0 34px;width:34px;height:34px;border-radius:50%;display:grid;place-items:center;background:var(--pet-ink);color:#fff;font-size:16px}
+
+/* Reviews */
+.pet-sign__reviews{margin:0 0 34px}
+.pet-sign__reviews figure{margin:0 0 12px;padding:16px;border:1px solid var(--pet-line);border-radius:10px;background:#fff}
+.pet-sign__reviews blockquote{margin:0 0 8px;font-size:17px;line-height:1.55;font-style:italic}
+.pet-sign__reviews figcaption{font-size:14px;color:var(--pet-muted)}
+
+/* Story + gift line */
+.pet-sign__story{margin:0 0 34px;padding:22px 18px;border-radius:12px;background:var(--pet-paper)}
+
+/* Sticky add-to-basket bar (phones only) */
+.pet-sign__sticky{display:none}
+@media (max-width: 989px){
+  .pet-sign__thumbnails{display:none!important}
+  .pet-sign__gallery-note{margin-top:4px}
+  .pet-sign__sticky:not([hidden]){display:flex;position:fixed;left:0;right:0;bottom:0;z-index:1002;align-items:center;justify-content:space-between;gap:12px;padding:10px 14px calc(10px + env(safe-area-inset-bottom));background:#fff;border-top:1px solid var(--pet-line);box-shadow:0 -6px 18px #0000001a}
+  .pet-sign__sticky-price{margin:0;display:flex;align-items:baseline;gap:8px}
+  .pet-sign__sticky-price strong{font-size:20px;font-weight:800}
+  .pet-sign__sticky-btn{flex:0 0 auto;min-height:50px;padding:12px 22px;border:0;border-radius:999px;background:#b0af9b;color:#232323;font:inherit;font-size:17px;font-weight:800;letter-spacing:.04em;cursor:pointer}
+  .pet-sign__sticky-btn:disabled{opacity:.6}
+}
+.pet-sign__submit{font-weight:800!important;letter-spacing:.03em!important}
