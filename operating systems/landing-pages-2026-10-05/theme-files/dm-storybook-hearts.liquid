{%- comment -%}
  Storybook Collection hanging hearts (14-15 Oct 2026). These five use the
  existing native heart builder (assets/daisy-heart-builder.js) with configs kept
  here, so the 261 KB snippets/dm-heart-builder.liquid (theme-only, not in the
  repo) stays untouched. Rendered from dm-pebble-picture-builder, which every
  product form renders (sometimes twice), so the builder script is loaded once by
  a guarded module. The module runs after the gift-wrap patch module in <head>,
  which adds the Gift Wrap Kit extra to the first [data-daisy-heart-config].
  Size, 7/8-pebble and second-heart prices follow the family blossom heart; gift
  box designs and their order are the owner's list (15 Oct); the gift box card
  shows the designs straight away (tap to add, tap again to remove). Fold into
  dm-heart-builder.liquid at that file's next edit.
{%- endcomment -%}
{%- liquid
  assign dm_sbh_kind = ''
  case product.handle
    when 'personalised-wedding-pebble-heart-gift-storybook-collection-wedding-gift-anniversary-gift'
      assign dm_sbh_kind = 'sbwedheart'
    when 'personalised-engagement-pebble-heart-gift-the-storybook-collection-engagement-or-proposal-gift-uk'
      assign dm_sbh_kind = 'sbengheart'
    when 'personalised-family-pebble-heart-gift-the-storybook-collection-unique-mothers-day-christmas-birthday-gift'
      assign dm_sbh_kind = 'sbfamheart'
    when 'personalised-new-baby-pebble-heart-gift-the-storybook-collection-unique-new-baby-gift'
      assign dm_sbh_kind = 'sbbabyheart'
    when 'personalised-christening-pebble-heart-gift-the-storybook-collection-unique-christening-baptism-gift'
      assign dm_sbh_kind = 'sbchrheart'
  endcase
-%}
{%- if dm_sbh_kind != '' -%}
  {%- assign dm_sbh_variant = product.selected_or_first_available_variant -%}
