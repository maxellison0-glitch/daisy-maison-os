              { "key": "(Offer) Line 1", "source": "Line 1", "label": "Personalisation to go beneath pebbles (line 1)", "type": "text", "required": true },
              { "key": "(Offer) Line 2", "source": "Line 2", "label": "Personalisation to go beneath pebbles (line 2)", "type": "text", "required": false },
              { "key": "(Offer) Line 3", "source": "Line 3", "label": "Personalisation to go beneath pebbles (line 3)", "type": "text", "required": false }
            ]
          {%- when 'moon' -%}
            "eyebrow": "Free personalisation",
            "heading": "Create your moon & back picture",
            "copy": "Choose the frame, two pebble people and optional names beneath the artwork.",
            "secondOffer": { "key": "*SECOND FRAME*", "variantId": {{ dm_second_variant.id | json }}, "price": {{ dm_second_variant.price | json }}, "yes": "YES Please", "no": "NO Thanks", "label": "Buy a second one", "note": "Add another personalised frame", "priceLabel": {{ dm_second_variant.price | money | json }} },
            "people": { "mode": "fixed", "count": 2, "fields": ["Pebble 1", "Pebble 2"] },
