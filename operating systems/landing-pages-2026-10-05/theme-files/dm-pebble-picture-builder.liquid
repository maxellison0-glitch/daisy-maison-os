{%- if dm_pebble_enabled -%}
  {%- liquid
    assign dm_main_variant = product.selected_or_first_available_variant
    assign dm_second_variant = all_products[dm_second_offer_handle].selected_or_first_available_variant
    assign dm_heart_product = all_products[dm_heart_offer_handle]
    assign dm_heart_variant = dm_heart_product.selected_or_first_available_variant
    comment
      Matching gift box: the real small "From This Day Forward" box at its real
      price, offered as a third choice on the heart card. Looked up by id so the
      price tracks the catalogue.
    endcomment
    for dm_box_candidate in all_products['family-love-gift-boxes'].variants
      if dm_box_candidate.id == dm_heart_box_id and dm_box_candidate.available
        assign dm_heart_box = dm_box_candidate
      endif
    endfor
    assign dm_extra_people_variant = all_products[dm_extra_people_handle].selected_or_first_available_variant
    assign dm_gift_wrap_variant = all_products['gift-wrapping'].selected_or_first_available_variant
    assign dm_easel_variant = all_products['wooden-display-easel'].selected_or_first_available_variant
    comment
      Easel thumbnail cascade: an image named after this product's handle wins,
      else the generic pebble scene (any 'pebble' file that is not a
      handle-specific one), else the product's featured image.
    endcomment
    assign dm_easel_image = all_products['wooden-display-easel'].featured_image
    for dm_easel_candidate in all_products['wooden-display-easel'].images
      if dm_easel_candidate.src contains 'pebble'
        unless dm_easel_candidate.src contains 'personalised'
          assign dm_easel_image = dm_easel_candidate
        endunless
      endif
    endfor
    assign dm_easel_exact = false
    for dm_easel_candidate in all_products['wooden-display-easel'].images
      if dm_easel_candidate.src contains product.handle
        assign dm_easel_image = dm_easel_candidate
        assign dm_easel_exact = true
        break
      endif
    endfor
    assign dm_easel_thumb = dm_easel_image | image_url: width: 160
    assign dm_easel_zoom = dm_easel_image | image_url: width: 1200
    unless dm_easel_exact
      if product.handle contains 'family'
        assign dm_easel_thumb = 'dm-easel-family-pebble-160.jpg' | asset_url
        assign dm_easel_zoom = 'dm-easel-family-pebble.jpg' | asset_url
      endif
    endunless
    assign dm_lucky_sixpence_variant = all_products['lucky-sixpence-boxed-old-new-borrowed-blue'].selected_or_first_available_variant
    comment
      Spray add-on rollout list: builder-enabled pebble pictures with >=1 sale in the
      30 days to 2026-07-12 (Max's rule). Maintained by agents; add/remove handles here.
    endcomment
    assign dm_spray_handles = 'mum-personalised-pebble-sketch-picture,family-flutterby-blossom-tree-personalised-pebble-picture-copy,engagement-proposal-personalised-pebble-artwork,on-your-christening-personalised-pebble-picture,mum-flutterby-blossom-tree-personalised-pebble-picture,family-blossom-tree-personalised-pebble-picture-gift-2,golden-skies-family-pebble-picture,same-stars-family-pebble-picture,together-family-pebble-picture,family-swing-personalised-pebble-picture,wedding-swing-personalised-pebble-picture,on-your-wedding-day-family-personalised-pebble-picture-gift,new-home-personalised-pebble-picture,true-friends-personalised-pebble-picture,wedding-church-personalised-pebble-picture,beach-proposal-personalised-pebble-picture-gift,couple-love-tree-personalised-pebble-picture-6-colour-options,always-forever-personalised-pebble-artwork,birthday-blossom-tree-personalised-pebble-picture,dad-grandad-simple-moments-personalised-pebble-picture,grandparent-flutterby-blossom-tree-personalised-pebble-picture,always-my-sister-personalised-pebble-picture,family-walk-in-the-park-personalised-pebble-picture,beach-wedding-personalised-pebble-picture,grandparent-personalised-pebble-sketch-picture,graduation-personalised-pebble-picture,home-sweet-home-personalised-pebble-picture,our-world-family-personalised-pebble-artwork' | split: ','
    assign dm_spray_enabled = false
    comment
      28 Sep 2026: spray row switched off on every picture (1 sale in 313 eligible orders, 12 Aug-26 Sep).
      To bring it back, add after this comment: if dm_spray_handles contains product.handle / assign dm_spray_enabled = true / endif.
    endcomment
    assign dm_spray_product = all_products['daisy-maison-picture-cleaning-spray']
    assign dm_spray_variant = dm_spray_product.variants | where: 'sku', 'DM-SPRAY-SS-495' | first
    unless dm_spray_variant
      assign dm_spray_variant = dm_spray_product.selected_or_first_available_variant
    endunless
  -%}
  <div class="dm-pebble-picture" data-daisy-pebble-picture data-pebble-kind="{{ dm_pebble_kind }}" data-people-count="2" data-second-frame="false" hidden>
    <script type="application/json" data-daisy-pebble-picture-config>
      {
        "handle": {{ product.handle | json }},
        "title": {{ product.title | json }},
        "variantId": {{ dm_main_variant.id | json }},
        "currency": {{ localization.country.currency.iso_code | default: cart.currency.iso_code | default: shop.currency | json }},
        "image": {{ product.featured_image | image_url: width: 720 | json }},
        "giftWrap": { "variantId": {{ dm_gift_wrap_variant.id | json }}, "price": {{ dm_gift_wrap_variant.price | json }}, "thumb": {{ all_products['gift-wrapping'].featured_image | image_url: width: 160 | json }}, "zoom": {{ all_products['gift-wrapping'].featured_image | image_url: width: 1200 | json }} },
        "easel": { "variantId": {{ dm_easel_variant.id | json }}, "price": {{ dm_easel_variant.price | json }}, "thumb": {{ dm_easel_thumb | json }}, "zoom": {{ dm_easel_zoom | json }} },
        {%- if dm_spray_enabled %}
        "spray": { "variantId": {{ dm_spray_variant.id | json }}, "price": {{ dm_spray_variant.price | json }}, "thumb": {{ dm_spray_product.featured_image | image_url: width: 160 | json }}, "zoom": {{ dm_spray_product.featured_image | image_url: width: 1200 | json }} },
        {%- endif %}
        {%- comment -%}
          Personalisation is copied straight across, slot for slot: whatever the
          customer typed above the pebbles on the picture goes above the pebbles
          on the heart, line 1 to line 1, line 2 to line 2. Read at add-to-cart
          (not on tick) so late edits to the picture carry through.
        {%- endcomment -%}
        {%- if dm_heart_offer_handle != '' and dm_heart_variant %}
        "heartOffer": {
          "variantId": {{ dm_heart_variant.id | json }},
          "price": {{ dm_heart_variant.price | json }},
          "name": "Matching Pebble Hanging Heart",
          {%- if dm_heart_box %}
          "box": { "variantId": {{ dm_heart_box.id | json }}, "price": {{ dm_heart_box.price | json }}, "name": {{ dm_heart_box.title | prepend: 'Gift Box - ' | json }} },
          {%- endif %}
          {%- comment -%}
            Card artwork is the heart-in-gift-box shot (also gallery slot 2), not
            the heart product's own featured image — it has to sell both the
            £14.95 heart and the £18.90 heart+box option.
          {%- endcomment -%}
          {%- if dm_heart_card_image != '' %}
          "thumb": {{ dm_heart_card_image | append: '&width=320' | json }},
          "zoom": {{ dm_heart_card_image | append: '&width=1600' | json }},
          {%- else %}
          "thumb": {{ dm_heart_product.featured_image | image_url: width: 320 | json }},
          "zoom": {{ dm_heart_product.featured_image | image_url: width: 1600 | json }},
          {%- endif %}
          "sizeKey": "Size of heart",
          "sizeValue": "Small 10 X 10cm (£14.95)",
          "fields": [
            { "key": "Date to appear above pebble people", "source": {{ dm_heart_top_source | json }}, "label": "Text above the pebbles", "required": true },
            { "key": "Text to appear below pebble people (Line 1)", "source": "Line 1", "label": "Line 1 beneath the pebbles", "required": true },
            { "key": "Text to appear below pebble people (Line 2)", "source": "Line 2", "label": "Line 2 beneath the pebbles", "required": false }
          ]
        },
        {%- endif %}
        "prices": {
          "base": {{ dm_main_variant.price | json }},
          "compareAt": {{ dm_main_variant.compare_at_price | default: dm_main_variant.price | json }}
        },
        {%- case dm_pebble_kind -%}
          {%- when 'always' -%}
            "eyebrow": "Free personalisation",
            "heading": "Create your pebble picture",
            "copy": "Choose the frame, pebble people and wording for your handmade Always & Forever picture.",
            "secondOffer": { "key": "*SECOND FRAME*", "variantId": {{ dm_second_variant.id | json }}, "price": {{ dm_second_variant.price | json }}, "yes": "YES Please", "no": "NO Thanks", "label": "Buy a second one", "note": "Add another personalised frame", "priceLabel": {{ dm_second_variant.price | money | json }} },
            "people": { "mode": "fixed", "count": 2, "fields": ["Left pebble", "Right pebble"] },
            "fields": [
              { "key": "Frame Colour", "label": "Frame Colour", "type": "select", "required": true, "values": {{ dm_frame_values }} },
              { "key": "Left pebble", "label": "Left pebble", "type": "select", "required": true, "values": ["Adult", "Teen", "Child", "Baby"] },
              { "key": "Right pebble", "label": "Right pebble", "type": "select", "required": true, "values": ["Adult", "Teen", "Child", "Baby"] },
              { "key": "Line 1", "label": "Personalisation to appear beneath the pebble people Line 1", "type": "text", "required": true, "placeholder": "e.g. Max & Daisy" },
              { "key": "Line 2", "label": "Personalisation to appear beneath the pebble people Line 2", "type": "text", "required": false, "placeholder": "Optional smaller text" }
            ],
            "offerFields": [
              { "key": "(Offer) Frame Colour", "source": "Frame Colour", "label": "Frame Colour", "type": "select", "required": true, "values": {{ dm_frame_values }} },
              { "key": "(Offer) Left pebble", "source": "Left pebble", "label": "Left pebble", "type": "select", "required": true, "values": ["Adult", "Teen", "Child", "Baby"] },
              { "key": "(Offer) Right pebble", "source": "Right pebble", "label": "Right pebble", "type": "select", "required": true, "values": ["Adult", "Teen", "Child", "Baby"] },
              { "key": "(Offer) Line 1", "source": "Line 1", "label": "Personalisation to appear beneath the pebble people Line 1", "type": "text", "required": true, "placeholder": "e.g. Max & Daisy" },
              { "key": "(Offer) Line 2", "source": "Line 2", "label": "Text 2", "type": "text", "required": true, "placeholder": "Second frame smaller text" }
            ]
          {%- when 'family' -%}
            "eyebrow": "Free personalisation",
            "heading": "Create your family pebble picture",
